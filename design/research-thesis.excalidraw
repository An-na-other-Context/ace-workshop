      "versionNonce": 700122,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794800000000,
      "link": null,
      "locked": false,
      "text": "How can I create an accessible, seamless digital game for bottom-up learning in which I and other\nneurodivergent learners with similar traits learn to build complex technology from scratch?",
      "originalText": "How can I create an accessible, seamless digital game for bottom-up learning in which I and other neurodivergent learners with similar traits learn to build complex technology from scratch?",
      "fontSize": 30,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "thesis-l3",
      "type": "text",
      "x": -822,
      "y": -472,
      "width": 284,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#f1ece2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
