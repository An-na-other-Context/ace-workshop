      "versionNonce": 700250,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794800000000,
      "link": null,
      "locked": false,
      "text": "Time: no standard length; a time box works when the scope can\nshrink.",
      "originalText": "Time: no standard length; a time box works when the scope can shrink.",
