      "versionNonce": 700124,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794800000000,
      "link": null,
      "locked": false,
      "text": "Reverse engineering, hardware hacking and building from scratch, for example an IC, a smart device or an operating\nsystem.",
      "originalText": "Reverse engineering, hardware hacking and building from scratch, for example an IC, a smart device or an operating system.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "thesis-l4",
      "type": "text",
      "x": -822,
      "y": -404,
      "width": 284,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#f1ece2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp-thesis"
      ],
      "frameId": null,
      "index": "bLZ",
      "roundness": null,
