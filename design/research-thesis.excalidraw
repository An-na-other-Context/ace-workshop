      "versionNonce": 700252,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794800000000,
      "link": null,
      "locked": false,
      "text": "Reframing: the problem sits in the design, not the person:\nmismatch, systemic mismatch, critical disability studies,\nneurodiversity paradigm; the human rights model where design\nfailed.",
      "originalText": "Reframing: the problem sits in the design, not the person: mismatch, systemic mismatch, critical disability studies, neurodiversity paradigm; the human rights model where design failed.",
