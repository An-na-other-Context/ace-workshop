      "version": 1,
      "versionNonce": 700130,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794800000000,
      "link": null,
      "locked": false,
      "text": "Context",
      "originalText": "Context",
      "fontSize": 22,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "thesis-t4",
      "type": "text",
      "x": -522,
      "y": -404,
      "width": 1344,
      "height": 100,
      "angle": 0,
      "strokeColor": "#f1ece2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp-thesis"
      ],
      "frameId": null,
      "index": "bLa",
      "roundness": null,
      "seed": 700127,
      "version": 1,
      "versionNonce": 700128,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794800000000,
      "link": null,
      "locked": false,
      "text": "The places where people learn about technology are designed around one assumed 'normal' learner. When a learner's needs\ndon't match that design, the learner gets stuck. That is a design problem, not the learner's fault: a mismatch between\nneeds and design, and between learners and what institutions accommodate today. Where design has failed to accommodate,\nlearners have a right to support on an equal basis.",
      "originalText": "The places where people learn about technology are designed around one assumed 'normal' learner. When a learner's needs don't match that design, the learner gets stuck. That is a design problem, not the learner's fault: a mismatch between needs and design, and between learners and what institutions accommodate today. Where design has failed to accommodate, learners have a right to support on an equal basis.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
