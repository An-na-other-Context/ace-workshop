    {
      "id": "thesis-t2",
      "type": "text",
      "x": -822,
      "y": -575,
      "width": 1644,
      "height": 75,
      "angle": 0,
      "strokeColor": "#f1ece2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
