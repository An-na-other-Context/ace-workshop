      "frameId": null,
      "index": "bLc",
      "roundness": null,
      "seed": 700131,
      "version": 2,
      "versionNonce": 950001,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795033768382,
      "link": null,
      "locked": false,
      "text": "A learning environment that meets learners where they are and where they need it: a clear outcome, no gaps, nothing\nassumed down to a set level; a clear puzzle to apply and play with what they learn, with progress they can see; a start\nwith what they have, without buying or knowing everything first; and what they are solving stays in view. So learners\ngain skills otherwise out of reach for them. (Widened 18.11.2026; Claude's wording, at Anna's request.)",
      "originalText": "A learning environment that meets learners where they are and where they need it: a clear outcome, no gaps, nothing assumed down to a set level; a clear puzzle to apply and play with what they learn, with progress they can see; a start with what they have, without buying or knowing everything first; and what they are solving stays in view. So learners gain skills otherwise out of reach for them. (Widened 18.11.2026; Claude's wording, at Anna's request.)",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
