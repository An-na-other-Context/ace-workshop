      "type": "text",
      "x": 1078,
      "y": 551.5,
      "width": 744,
      "height": 75,
      "angle": 0,
      "strokeColor": "#f1ece2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp-note-research-28"
      ],
      "frameId": null,
      "index": "bMW",
      "roundness": null,
      "seed": 700245,
      "version": 1,
      "versionNonce": 700246,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794800000000,
      "link": null,
      "locked": false,
      "text": "Thesis: no fixed formula. Parts that recur: a short question,\ncontext, method, outcome and for whom; a preferred state and why\nit is better; boundaries.",
      "originalText": "Thesis: no fixed formula. Parts that recur: a short question, context, method, outcome and for whom; a preferred state and why it is better; boundaries.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "note-research-28-t2",
      "type": "text",
      "x": 1078,
      "y": 632.5,
      "width": 744,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f1ece2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp-note-research-28"
      ],
      "frameId": null,
      "index": "bMX",
      "roundness": null,
      "seed": 700247,
      "version": 1,
      "versionNonce": 700248,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794800000000,
      "link": null,
      "locked": false,
      "text": "Questions grow while making and drift; they are often worded late.",
      "originalText": "Questions grow while making and drift; they are often worded late.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
