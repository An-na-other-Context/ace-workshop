    {
      "id": "thesis-t5",
      "type": "text",
      "x": -522,
      "y": -286,
      "width": 1344,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#f1ece2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
